rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if request.resource.data.email is string
                   && request.resource.data.name is string
                   && request.resource.data.role in ['student', 'faculty', 'admin'];
    }

    // Events collection
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.resource.data.name is string
                   && request.resource.data.event_date is string;
    }

    // Registrations collection
    match /registrations/{registrationId} {
      allow read: if true;
      allow write: if request.resource.data.status in ['confirmed', 'cancelled'];
    }

    // Attendance records
    match /attendances/{attendanceId} {
      allow read: if true;
      allow write: if request.resource.data.status in ['present', 'absent'];
    }

    // Feedback and reviews
    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow write: if request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
    }

    // Announcements and bulletins
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if request.resource.data.title is string
                   && request.resource.data.category in ['Urgent', 'General', 'Event Update'];
    }
  }
}
